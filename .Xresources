Xft.dpi: 128

*background: #0f172a
*foreground: #cdd6f4
*cursorColor: #cdd6f4

*color0:  #1b2333
*color1:  #ff6b9b
*color2:  #7bd88f
*color3:  #ffd47e
*color4:  #7aa2f7
*color5:  #bb9af7
*color6:  #89dceb
*color7:  #cdd6f4
*color8:  #4c556a
*color9:  #ff8fb0
*color10: #9ce3af
*color11: #ffe9a7
*color12: #9ab8ff
*color13: #d0b8ff
*color14: #a6eaff
*color15: #ffffff

URxvt*transparent:                true
URxvt*font: xft:DejaVu Sans Mono:size=10:antialias=true, xft:Noto Emoji
URxvt*emoji: xft:Noto Color Emoji
URxvt.shading:                    32
URxvt*scrollBar:                  false
URxvt*mouseWheelScrollPage:       false
URxvt*cursorBlink:                true
URxvt*saveLines:                  5000
URxvt*internalBorder: 5
URxvt*geometry: 70x19

rofi.color-enabled: true
rofi.color-window: #1d1e26, #b5bd68, #b5bd68
rofi.color-normal: #1d1e26, #b0b287, #8c9440, #b0b287, #78824B
rofi.color-active: #1d1e26, #b0b287, #8c9440, #b0b287, #78824B
rofi.color-urgent: #1d1e26, #b0b287, #8c9440, #b0b287, #78824B

rofi.separator-style: solid
rofi.sidebar-mode: false
rofi.lines: 5
rofi.font: Source Code Pro Semibold 10.5
rofi.bw: 1
rofi.columns: 2
rofi.padding: 5
rofi.fixed-num-lines: true
rofi.hide-scrollbar: true
rofi.run-command: fish -c '{cmd}'
rofi.run-list-command: 'fish -c functions'
